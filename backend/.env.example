# --- Application ---
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:5174

# --- Database ---
DATABASE_URL=postgresql+asyncpg://...

# --- OpenAI ---
# Still required because Waypoint currently uses OpenAI embeddings.
OPENAI_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=100

# --- LLM generation ---
# Supported values: openai, bedrock
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_MAX_TOKENS=800

# --- OpenAI generation ---
# Used only when LLM_PROVIDER=openai.
OPENAI_REASONING_EFFORT=none

# --- Amazon Bedrock ---
# Used only when LLM_PROVIDER=bedrock.
# AWS credentials are resolved through the standard AWS credential chain
# and should not be stored in this file.
BEDROCK_REGION=ap-southeast-2