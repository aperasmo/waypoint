# syntax=docker/dockerfile:1

# Build Waypoint's locked Python environment separately from the Lambda runtime
# image so build tooling does not need to remain in the final container.
FROM public.ecr.aws/amazonlinux/amazonlinux:2023-minimal AS builder
RUN dnf install -y python3.12 && dnf clean all
COPY --from=ghcr.io/astral-sh/uv:0.12.6 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_NO_DEV=1
ENV UV_PYTHON_DOWNLOADS=0

WORKDIR /app/backend

COPY backend/pyproject.toml backend/uv.lock ./

RUN uv sync --locked --no-dev --no-install-project


# Lambda Web Adapter lets the existing FastAPI/Uvicorn application run behind
# API Gateway without rewriting Waypoint as Lambda-specific handlers.
FROM public.ecr.aws/amazonlinux/amazonlinux:2023-minimal AS runtime
RUN dnf install -y python3.12 && dnf clean all
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 \
    /lambda-adapter /opt/extensions/lambda-adapter

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/app/backend/.venv/bin:$PATH"

# Lambda Web Adapter forwards Lambda HTTP events to this local application port.
ENV PORT=8080
ENV AWS_LWA_PORT=8080
ENV AWS_LWA_READINESS_CHECK_PATH=/health
ENV AWS_LWA_READINESS_CHECK_HEALTHY_STATUS=200-399
ENV AWS_LWA_ASYNC_INIT=true
ENV AWS_LWA_REMOVE_BASE_PATH=/prod

WORKDIR /app/backend

COPY --from=builder /app/backend/.venv /app/backend/.venv

COPY backend/app ./app
COPY data /app/data

EXPOSE 8080

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]